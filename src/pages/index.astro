---
import '../styles/global.css';
import DevisForm from '../components/DevisForm.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
---
<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <!-- Préchargement hero — améliore le LCP (Largest Contentful Paint) -->
  <link rel="preload" as="image" href="/uploads/chape-suzuki-pamiers-vue-ensemble.jpeg" fetchpriority="high" />
  <title>Chape Liquide Occitanie — Applicateur agréé Sika, Ariège</title>
  <meta name="description" content="Expert chape liquide ciment en Occitanie. Applicateur agréé Sika. Devis gratuit sous 48h. Ariège (09), Aude (11), Haute-Garonne (31)." />
  <meta property="og:title" content="Chape Liquide Occitanie — Applicateur agréé Sika" />
  <meta property="og:description" content="Devis gratuit sous 48h. 18 villes Ariège, Aude, Haute-Garonne." />
  <meta property="og:type" content="website" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet" />

  <!-- ── SEO technique ── -->
  <link rel="canonical" href="https://chapeliquide-occitanie.fr/" />
  <meta name="robots" content="index, follow" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

  <!-- ── Open Graph complet ── -->
  <meta property="og:url"        content="https://chapeliquide-occitanie.fr/" />
  <meta property="og:image"      content="https://chapeliquide-occitanie.fr/uploads/chape-suzuki-pamiers-vue-ensemble.jpeg" />
  <meta property="og:image:alt"  content="Chantier chape liquide ciment 320 m² à Pamiers, Ariège — Chape Liquide Occitanie" />
  <meta property="og:locale"     content="fr_FR" />
  <meta property="og:site_name"  content="Chape Liquide Occitanie" />

  <!-- ── Twitter / X Card ── -->
  <meta name="twitter:card"        content="summary_large_image" />
  <meta name="twitter:title"       content="Chape Liquide Occitanie — Applicateur agréé Sika, Ariège" />
  <meta name="twitter:description" content="Expert chape liquide ciment en Occitanie. Devis gratuit sous 48h. Ariège, Aude, Haute-Garonne." />
  <meta name="twitter:image"       content="https://chapeliquide-occitanie.fr/uploads/chape-suzuki-pamiers-vue-ensemble.jpeg" />

  <!-- ── JSON-LD : LocalBusiness (signal local fort) ── -->
  <script is:inline type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": ["LocalBusiness", "HomeAndConstructionBusiness"],
    "name": "Chape Liquide Occitanie",
    "legalName": "EURL Balussou Cyril",
    "description": "Applicateur agréé Sika n°3197-2025 spécialisé en chape liquide ciment, ravoirage liquide et plancher chauffant en Occitanie. Zone d'intervention : Ariège (09), Aude (11) et Haute-Garonne (31). 480+ chantiers depuis 2016.",
    "url": "https://chapeliquide-occitanie.fr",
    "telephone": "+33687613987",
    "email": "contact@chapeliquide-occitanie.fr",
    "address": {
      "@type": "PostalAddress",
      "streetAddress": "2 rue des artisans",
      "addressLocality": "Mirepoix",
      "postalCode": "09500",
      "addressRegion": "Ariège",
      "addressCountry": "FR"
    },
    "geo": {
      "@type": "GeoCoordinates",
      "latitude": 43.0892,
      "longitude": 1.8726
    },
    "areaServed": [
      { "@type": "AdministrativeArea", "name": "Ariège" },
      { "@type": "AdministrativeArea", "name": "Aude" },
      { "@type": "AdministrativeArea", "name": "Haute-Garonne" }
    ],
    "aggregateRating": {
      "@type": "AggregateRating",
      "ratingValue": "5",
      "reviewCount": "1"
    },
    "sameAs": ["https://share.google/In62pPxyxtGlN47Tg"],
    "hasOfferCatalog": {
      "@type": "OfferCatalog",
      "name": "Prestations chape liquide en Occitanie",
      "itemListElement": [
        { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Chape liquide ciment", "description": "Chape fluide autonivelante à liant hydraulique, idéale pour construction neuve, rénovation, locaux commerciaux et planchers chauffants. Planéité garantie à 2 mm sous règle de 2 m." } },
        { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Ravoirage liquide", "description": "Remise à niveau de dalle existante, enrobage des gaines électriques et canalisations avant coulage de chape de finition." } },
        { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Plancher chauffant hydraulique", "description": "Enrobage de serpentins hydrauliques basse température avec chape liquide Sika Agilia. Épaisseur minimale 28 mm au-dessus des tubes, conformément au DTU 26.2." } },
        { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Chape haute résistance P4S", "description": "Sika ViscoChape® P4S, chape fluide fibrée classement UPEC P4S, sous avis technique DTA, pour locaux à trafic intensif." } }
      ]
    },
    "taxID": "533 165 684 00028",
    "priceRange": "€€",
    "openingHoursSpecification": [
      {
        "@type": "OpeningHoursSpecification",
        "dayOfWeek": ["Monday","Tuesday","Wednesday","Thursday","Friday"],
        "opens": "07:30",
        "closes": "18:00"
      }
    ],
    "image": "https://chapeliquide-occitanie.fr/uploads/chape-suzuki-pamiers-vue-ensemble.jpeg"
  }
  </script>

  <!-- ── JSON-LD : FAQPage (rich snippets Google — accordéon dans les SERPs) ── -->
  <script is:inline type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "Quel délai entre le coulage et la pose du carrelage ?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "La chape liquide Sika Agilia est circulable dès le lendemain du coulage. Pour la pose du revêtement : 14 jours minimum pour carrelage courant (format ≤ 60×60 cm) ; 21 à 28 jours pour grands formats (> 60×60 cm) ou parquet collé. Le seuil d'humidité résiduelle doit être inférieur à 2,5 CM% avant toute pose — nous transmettons le PV de mesure d'humidité. Ces délais sont sensiblement plus courts qu'une chape traditionnelle (4 à 6 semaines)."
        }
      },
      {
        "@type": "Question",
        "name": "Quel prix au m² pour une chape liquide en Occitanie en 2026 ?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Le prix d'une chape liquide varie selon 4 facteurs principaux : la surface (plus c'est grand, moins c'est cher au m²), l'épaisseur (45 mm en pose flottante, 28 mm sur plancher chauffant), le type de chape (ciment, P4S, plancher chauffant) et l'accessibilité du chantier (étage, accès pompe). Nous ne communiquons pas de tarif forfaitaire — chaque devis est établi après visite gratuite ou étude sur plans. Délai de devis : 48h ouvrées. Sans engagement."
        }
      },
      {
        "@type": "Question",
        "name": "Travaillez-vous avec les planchers chauffants ?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Oui, c'est 70 % de notre activité. Nous intervenons après la pose des nappes par votre plombier-chauffagiste. L'épaisseur minimale est de 28 mm au-dessus des tubes, conformément au DTU 26.2. La chape liquide Sika Agilia enrobe parfaitement les serpentins hydrauliques, ce qui améliore le rendement thermique par rapport à une chape traditionnelle. Compatible avec tous les systèmes à eau basse température et les planchers réversibles. PV de chantier transmis."
        }
      },
      {
        "@type": "Question",
        "name": "Quel est le délai de séchage avant circulation ?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "La chape liquide sèche en 3 paliers selon le DTU 26.2 : circulation piétonne légère possible dès 24 à 48h après coulage ; charges lourdes, échafaudages et pose des cloisons à partir de 7 jours ; pose du revêtement de sol à partir de 14 jours (carrelage courant) ou 21 à 28 jours (grands formats, parquet collé). Ces délais peuvent varier selon la température ambiante et l'hygrométrie du chantier."
        }
      },
      {
        "@type": "Question",
        "name": "Comment se déroule une journée de coulage ?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Arrivée de l'équipe et mise en place de la pompe Lancy entre 7h30 et 8h. La centrale béton agréée Sika livre le produit Sika Agilia directement sur site. Nos 2 applicateurs préparent les seuils, posent les joints périphériques et le film de désolidarisation. Le coulage est continu jusqu'à 400 m²/jour. Lissage barbotin inclus. Chantier balisé et rendu propre en fin de journée."
        }
      },
      {
        "@type": "Question",
        "name": "Intervenez-vous sur les maisons individuelles ou seulement les chantiers pro ?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Les deux, sans distinction. Nous intervenons sur maisons individuelles neuves, rénovations, logements collectifs, locaux commerciaux, EHPAD, hôtels et bâtiments tertiaires. Pas de surface minimale stricte — nous évaluons la faisabilité selon l'accès et la distance. Zone couverte : 18 villes en Ariège (09), Aude (11) et Haute-Garonne (31). Devis sur plan ou visite gratuite, sans engagement."
        }
      },
      {
        "@type": "Question",
        "name": "Qu'est-ce que l'agrément Sika et pourquoi est-ce important ?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "L'agrément Sika n°3197-2025 certifie que l'applicateur (EURL Balussou Cyril) est formé et habilité à mettre en œuvre les produits Sika Agilia — chapes fluides à liant hydraulique. Concrètement, cela garantit : une formulation maîtrisée conforme aux spécifications Sika, un PV de chantier transmis au maître d'ouvrage, et une traçabilité produit complète. La majorité des applicateurs en Ariège travaillent en Lafarge ; l'agrément Sika est le principal différenciant de Chape Liquide Occitanie."
        }
      },
      {
        "@type": "Question",
        "name": "Quelle est la différence entre chape liquide et chape traditionnelle ?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "La chape liquide (ou chape fluide) est pompée et autonivelante : elle s'étale seule sans dressage manuel grâce à sa fluidité. Résultat : planéité à 2 mm sous règle de 2 m (vs 5 mm pour la chape traditionnelle), séchage plus rapide (circulable en 24h vs 48-72h), épaisseur réduite, et cadence jusqu'à 400 m²/jour. La chape traditionnelle est appliquée à la règle par un applicateur — elle reste pertinente pour les très petites surfaces ou les profils atypiques. Pour toute surface supérieure à 50 m² avec plancher chauffant, la chape liquide est systématiquement recommandée."
        }
      }
    ]
  }
  </script>
</head>
<body>

<SiteHeader />

<main>

<!-- ═══════════════════════════════════════════════════════
     01 — HERO
═══════════════════════════════════════════════════════ -->
<section id="accueil" class="relative bg-bg">
  <div class="hero-grid grid grid-cols-[1fr_1.05fr] min-h-[720px] items-stretch">

    <!-- Left text panel -->
    <div class="flex flex-col justify-between relative p-5 md:p-[64px_64px_56px]">
      <span class="cross-mark top-10 right-10"></span>
      <div class="eyebrow"><span class="num">01</span>Accueil — Coulage chape liquide</div>

      <div>
        <h1 class="h-display hero-h1 text-[88px] mb-8">
          L'expertise chape liquide qui sécurise votre chantier en Occitanie.
        </h1>
        <p class="lead text-[21px] max-w-[520px] mb-10">
          Chape liquide ciment, planchers chauffants, ravoirage. Posés par des applicateurs agréés Sika. Devis sous 48h, intervention jusqu'à 1h30 autour de Mirepoix.
        </p>
        <div class="flex gap-[14px] items-center flex-wrap">
          <a href="#devis" class="btn btn-primary">
            Demander un devis gratuit <span class="arrow">→</span>
          </a>
          <a href="#guide-gratuit" class="btn btn-ghost-dark">
            Télécharger le guide chape <span class="arrow">↓</span>
          </a>
        </div>
      </div>

      <!-- Spec readout -->
      <div class="hero-stats grid grid-cols-2 border-t border-line pt-6">
        <div>
          <div class="spec mb-[6px]">Cadence</div>
          <div class="font-mono text-[22px] font-medium tracking-tight2 text-ink">400 m²/j</div>
        </div>
        <div>
          <div class="spec mb-[6px]">Délai devis</div>
          <div class="font-mono text-[22px] font-medium tracking-tight2 text-ink">&lt; 48 h</div>
        </div>
      </div>
    </div>

    <!-- Right image panel -->
    <div class="hero-img relative overflow-hidden bg-ink">
      <img src="/uploads/chape-suzuki-pamiers-vue-ensemble.jpeg" alt="Chape fluide ciment grand local commercial Pamiers Ariège"
        width="5712" height="4284" fetchpriority="high"
        class="w-full h-full object-cover brightness-[0.92]" />
      <div class="absolute bottom-6 left-6 right-6 flex justify-between items-end text-white">
        <div class="inline-block px-[10px] py-[6px] bg-black/50 backdrop-blur-sm font-mono text-[11px] tracking-wide6 uppercase">
          Chantier · 320 m² · Pamiers (09)
        </div>
        <div class="spec text-white/70 text-[10px]">CLO · 2025</div>
      </div>
    </div>
  </div>
</section>

<!-- ═══════════════════════════════════════════════════════
     TRUST BAND — Sika + chiffres clés
═══════════════════════════════════════════════════════ -->
<section class="bg-ink text-white py-9 px-5 md:px-16">
  <div class="trust-grid grid grid-cols-[1.1fr_3fr] gap-16 items-center">

    <!-- Badge Sika -->
    <div class="flex items-center gap-[18px] px-[18px] py-[14px] border border-white/[0.18] rounded-[3px]">
      <img src="/uploads/layout_sika_triangle.png" alt="Logo Sika" class="w-14 h-14 object-contain shrink-0" />
      <div>
        <div class="spec text-white/55 text-[10px] mb-1">Agrément</div>
        <div class="font-display font-semibold text-[15px] leading-[1.2]">
          Applicateur agréé Sika<br />
          <span class="mono text-[12px] text-white/60 font-normal">
            n°3197-2025 · Occitanie
          </span>
        </div>
      </div>
    </div>

    <!-- Chiffres -->
    <div class="trust-numbers grid grid-cols-4 gap-8">
      {[
        { val: 'Centaines',  label: 'de chantiers livrés' },
        { val: 'Des milliers', label: 'de m² coulés' },
        { val: '10 ans',  label: "d'expérience chape" },
        { val: '48 h',    label: 'Délai devis garanti' },
      ].map(({ val, label }) => (
        <div>
          <div class="font-display font-bold text-[38px] tracking-tight3 leading-none">{val}</div>
          <div class="spec text-white/55 mt-2 text-[11px]">{label}</div>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- ═══════════════════════════════════════════════════════
     02 — POURQUOI NOUS
═══════════════════════════════════════════════════════ -->
<section class="section-pad relative bg-bg py-[120px] px-16 pb-[100px]" id="expertise">
  <span class="cross-mark top-[60px] left-16"></span>
  <span class="cross-mark top-[60px] right-16"></span>

  <div class="split-2col grid grid-cols-[0.85fr_2fr] gap-20 mb-[72px]">
    <div>
      <div class="eyebrow"><span class="num">02</span>Pourquoi nous</div>
      <h2 class="h-section text-[56px] mt-6">
        Quatre raisons de signer avec nous, pas avec un autre.
      </h2>
    </div>
    <div class="split-2col-lead pt-12">
      <p class="lead text-[19px] max-w-[540px]">
        On ne fait que de la chape liquide. Pas de la maçonnerie, pas du carrelage, pas du second œuvre généraliste. Cette spécialisation, c'est ce qui sécurise votre planning et votre planéité.
      </p>
    </div>
  </div>

  <div class="reasons-grid grid grid-cols-4">
    {[
      { n:'01', title:'Applicateur agréé Sika', body:'La majorité des artisans Ariège travaillent en Lafarge. Nous coulons en Sika Agilia : garantie procédé n°3197-2025, traçabilité produit, PV de chantier transmis.', tag:'Différenciation' },
      { n:'02', title:'Devis sous 48 h ouvrées', body:'Mesure des cotes sur plan ou visite gratuite si chantier dans nos 18 villes. Vous recevez le devis ferme et détaillé sous 48 heures, pas un mois plus tard.', tag:'Engagement' },
      { n:'03', title:"Cadence jusqu'à 400 m²/jour", body:"Pompe Lancy professionnelle, livraison en camion toupie, équipe de 2 applicateurs. Sur les grandes surfaces (>300 m²), le coulage s'enchaîne sans rupture de charge.", tag:'Capacité' },
      { n:'04', title:'1h30 autour de Mirepoix', body:'18 villes desservies en Ariège, Aude et Haute-Garonne. Pas de surcoût déplacement dans la zone. Étude possible au-delà sur demande.', tag:'Couverture' },
    ].map((it, i) => (
      <div class={`reason-card bg-bg-warm flex flex-col justify-between min-h-[320px] p-[32px_28px_28px] border border-line${i > 0 ? ' border-l-0' : ''}`}>
        <div>
          <div class="flex justify-between items-baseline mb-7">
            <span class="font-mono font-medium text-accent text-[13px]">{it.n}</span>
            <span class="spec text-[9px]">{it.tag}</span>
          </div>
          <h3 class="font-display font-bold text-[22px] tracking-tight2 leading-[1.1] mb-4">{it.title}</h3>
          <p class="text-[14px] leading-[1.55] text-ink-soft">{it.body}</p>
        </div>
      </div>
    ))}
  </div>
</section>

<!-- ═══════════════════════════════════════════════════════
     03 — NOS SERVICES
═══════════════════════════════════════════════════════ -->
<section id="services" class="section-pad bg-bg-deep py-[120px] px-16 pb-[100px]">
  <div class="split-2col grid grid-cols-[0.85fr_2fr] gap-20 mb-16 items-end">
    <div>
      <div class="eyebrow"><span class="num">03</span>Nos services</div>
      <h2 class="h-section text-[56px] mt-6">Quatre prestations, un seul applicateur.</h2>
    </div>
    <div class="pb-3">
      <a href="#expertise" class="font-display font-semibold text-[15px] border-b border-ink pb-1">
        Voir le dossier technique complet <span class="font-mono">→</span>
      </a>
    </div>
  </div>

  <div class="services-grid grid grid-cols-2 gap-6">
    {[
      { n:'01', title:'Chape liquide ciment', desc:"La chape de référence pour maisons individuelles, logements collectifs et locaux tertiaires. Coulée par pompe depuis une centrale béton agréée Sika, elle s'autonivelle parfaitement sans intervention manuelle. Idéale en pose flottante sur isolant, désolidarisée ou adhérente selon le support. Produits mis en œuvre : Sika ViscoChape® et ViscoChape® XLS.", specs:['Circulable dès le lendemain — revêtement posable à 14 jours',"Grands volumes maîtrisés — jusqu'à 400 m²/jour et plus selon chantier",'Compatible carrelage, parquet, PVC, moquette'], img:'/uploads/coulage-villeneuve-dolmes-salon.jpeg', imgAlt:"Coulage chape liquide ciment en salon — Villeneuve-d'Olmes, Ariège (09)" },
      { n:'02', title:'Ravoirage liquide', desc:"En rénovation, la dalle existante est rarement parfaitement plane. Le ravoirage liquide rattrape les défauts de niveau, noie les gaines électriques et canalisations, et crée un support parfaitement plan pour la pose de l'isolant thermo-acoustique — avant la chape de finition. Obligatoire selon DTU 52.10 en cas de défaut d'altimétrie. Circulable en 24 à 36h.", specs:['Remise à niveau de dalle en une journée','Noie gaines, câbles et canalisations existantes','Support idéal pour isolant avant chape de finition'], img:'/uploads/ravoirage-mirepoix-gaines.jpeg', imgAlt:'Ravoirage liquide avec passage de gaines chauffantes — Mirepoix, Ariège (09)' },
      { n:'03', title:'Plancher chauffant', desc:"L'enrobage des serpentins hydrauliques exige une formulation précise : le contact thermique entre le tube et la masse coulée conditionne le rendement du chauffage. Sika ViscoChape® et ViscoChape® XLS sont certifiées pour cet usage. Compatible avec les planchers chauffants à eau basse température et les systèmes réversibles.", specs:['Enrobage parfait des tubes — rendement chauffage maximal','Compatible tous systèmes eau basse température','Devis et PV de chantier transmis'], img:'/uploads/plancher-chauffant-montgaillard.jpeg', imgAlt:'Enrobage plancher chauffant hydraulique avec chape Sika — Montgaillard, Ariège (09)' },
      { n:'04', title:'Chape haute résistance P4S', desc:"Pour les locaux à fortes sollicitations mécaniques : hypermarchés, halls de gare, locaux commerciaux classés P4S. La Sika ViscoChape® P4S est une chape fluide fibrée sous avis technique, spécifiquement développée pour répondre aux exigences du classement UPEC P4S. Mise en œuvre uniquement en pose désolidarisée, sur support neuf ou en rénovation.", specs:['Productivité > 1 000 m²/jour sur grands chantiers','Classement UPEC P4S — exigences commerciales et tertiaires','Sous avis technique DTA — garantie procédé et assurabilité'], img:'/uploads/Chape-P4S-commercial.jpg', imgAlt:'Chape haute résistance P4S en local commercial — Applicateur agréé Sika CLO' },
    ].map((s) => (
      <a href={`#service-${s.n}`} class="service-card bg-bg-warm grid grid-cols-2 border border-line overflow-hidden min-h-[320px]">
        <div class="service-inner flex flex-col justify-between p-[32px_32px_28px]">
          <div>
            <div class="flex justify-between items-baseline mb-6">
              <span class="font-mono text-accent text-[13px] font-medium">Service · {s.n}</span>
              <span class="font-mono text-ink-mute text-[16px]">→</span>
            </div>
            <h3 class="font-display font-bold text-[30px] tracking-[-0.025em] leading-[1.05] mb-4">{s.title}</h3>
            <p class="text-[14px] leading-[1.55] text-ink-soft">{s.desc}</p>
          </div>
          <div class="flex flex-col gap-[6px] mt-6 border-t border-dashed border-line pt-4">
            {s.specs.map((sp) => (
              <div class="flex justify-between items-baseline">
                <span class="spec text-[10px]">{sp}</span>
              </div>
            ))}
          </div>
        </div>
        <div class="service-img bg-ink overflow-hidden">
          <img src={s.img} alt={s.imgAlt} loading="lazy" width="5712" height="4284" class="w-full h-full object-cover" />
        </div>
      </a>
    ))}
  </div>
</section>

<!-- ═══════════════════════════════════════════════════════
     04 — GUIDE GRATUIT (lead magnet)
═══════════════════════════════════════════════════════ -->
<section id="guide-gratuit" class="section-pad relative bg-ink text-white py-[100px] px-16">
  <div class="ebook-grid grid grid-cols-[1.3fr_1fr] gap-20 items-center">
    <div>
      <div class="eyebrow on-dark"><span class="num">04</span>Guide gratuit · Édition 2026</div>
      <h2 class="h-section text-[56px] mt-6 mb-7 text-white">
        Chape liquide : le guide pour choisir sans se tromper.
      </h2>

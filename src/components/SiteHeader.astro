---
// Header partagé — utilisé sur index.astro et pages villes.
// Les pages villes n'ont pas toutes les sections de la home (pas de #expertise,
// #zones-intervention, #guide-gratuit) : pour ces ancres-là on renvoie toujours
// vers la home. Les sections qui existent sur les deux gabarits (#services,
// #realisations, #devis) restent locales à la page courante pour ne pas éjecter
// le visiteur d'une page ville vers la home alors que la section est juste en dessous.
interface Props {
  isVillePage?: boolean;
}
const { isVillePage = false } = Astro.props;

const sharedSections = new Set(['services', 'realisations', 'devis']);

function navHref(id: string) {
  if (!isVillePage || sharedSections.has(id)) return `#${id}`;
  return `/#${id}`;
}
---
<header class="site-header">
  <a href="/" class="header-logo">
    <img src="/logo/clo-horizontal-positif.svg" alt="Chape Liquide Occitanie" height="44" style="height:44px;width:auto;display:block;" />
  </a>

  <nav class="header-nav" id="mobile-nav">
    {[
      { label: 'Expertise',            id: 'expertise' },
      { label: 'Services',             id: 'services' },
      { label: "Zones d'intervention", id: 'zones-intervention' },
      { label: 'Réalisations',         id: 'realisations' },
      { label: 'Guide gratuit',        id: 'guide-gratuit' },
      { label: 'Contact',              id: 'devis' },
    ].map(({ label, id }) => (
      <a href={navHref(id)}>{label}</a>
    ))}
  </nav>

  <div class="header-cta">
    <a href="tel:0687613987" class="header-tel" data-tel-section="header">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
        <path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.07-8.67A2 2 0 014.11 2h3a2 2 0 012 1.72c.127.96.361 1.903.7 2.81a2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0122 16.92z"/>
      </svg>
      <div>
        <div class="spec text-[10px]">Devis téléphone</div>
        <div class="font-mono font-semibold text-[14px]">06 87 61 39 87</div>
      </div>
    </a>
    <a href={navHref('devis')} class="btn btn-primary py-3 px-[18px] text-[14px]">
      Devis gratuit <span class="arrow">→</span>
    </a>
  </div>

  <button type="button" class="menu-toggle" aria-label="Ouvrir le menu" aria-expanded="false" aria-controls="mobile-nav">
    <svg class="icon-burger" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
      <path d="M3 6h18M3 12h18M3 18h18" />
    </svg>
    <svg class="icon-close" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
      <path d="M6 6l12 12M18 6L6 18" />
    </svg>
  </button>
</header>

<script>
  // Menu mobile — le header-nav classique est display:none sous 768px (voir global.css),
  // ce bouton est le seul moyen d'y accéder sur mobile.
  const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
  const nav = document.getElementById('mobile-nav');

  toggle?.addEventListener('click', () => {
    const isOpen = nav?.classList.toggle('is-open') ?? false;
    toggle.setAttribute('aria-expanded', String(isOpen));
  });

  nav?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => {
      nav.classList.remove('is-open');
      toggle?.setAttribute('aria-expanded', 'false');
    });
  });
</script>

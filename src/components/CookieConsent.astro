---
const GA_MEASUREMENT_ID = 'G-KQ8ETJ8NGK';
---
<div id="cookie-banner" class="cookie-banner" hidden>
  <p class="cookie-text">
    Ce site utilise Google Analytics pour mesurer son audience (statistiques de visites, anonymisées). Aucune donnée n'est utilisée à des fins publicitaires.
    <a href="/politique-confidentialite#cookies">En savoir plus</a>
  </p>
  <div class="cookie-actions">
    <button id="cookie-refuse" type="button" class="btn btn-ghost-light">Refuser</button>
    <button id="cookie-accept" type="button" class="btn btn-primary">Accepter</button>
  </div>
</div>

<style>
  .cookie-banner {
    position: fixed; left: 16px; right: 16px; bottom: 16px; z-index: 100;
    max-width: 640px; margin: 0 auto;
    background: var(--dark); color: rgba(255,255,255,0.85);
    border-radius: 6px; padding: 18px 22px;
    display: flex; flex-wrap: wrap; align-items: center; gap: 16px;
    box-shadow: 0 8px 30px rgba(0,0,0,0.25);
  }
  .cookie-banner[hidden] { display: none; }
  .cookie-text { font-size: 13px; line-height: 1.6; flex: 1 1 320px; }
  .cookie-text a { color: #fff; text-decoration: underline; text-underline-offset: 2px; }
  .cookie-actions { display: flex; gap: 10px; flex-shrink: 0; }
  .cookie-actions .btn { padding: 10px 18px; font-size: 13px; }
</style>

<script define:vars={{ GA_MEASUREMENT_ID }}>
  const CONSENT_KEY = 'clo-analytics-consent';

  function loadGoogleAnalytics() {
    if (window.__gaLoaded) return;
    window.__gaLoaded = true;

    const script = document.createElement('script');
    script.async = true;
    script.src = `https://www.googletagmanager.com/gtag/js?id=${GA_MEASUREMENT_ID}`;
    document.head.appendChild(script);

    window.dataLayer = window.dataLayer || [];
    function gtag(){ window.dataLayer.push(arguments); }
    window.gtag = gtag;
    gtag('js', new Date());
    gtag('config', GA_MEASUREMENT_ID);
  }

  function showBanner() {
    document.getElementById('cookie-banner')?.removeAttribute('hidden');
  }

  function hideBanner() {
    document.getElementById('cookie-banner')?.setAttribute('hidden', '');
  }

  const consent = localStorage.getItem(CONSENT_KEY);
  if (consent === 'granted') {
    loadGoogleAnalytics();
  } else if (consent !== 'denied') {
    showBanner();
  }

  document.getElementById('cookie-accept')?.addEventListener('click', () => {
    localStorage.setItem(CONSENT_KEY, 'granted');
    loadGoogleAnalytics();
    hideBanner();
  });

  document.getElementById('cookie-refuse')?.addEventListener('click', () => {
    localStorage.setItem(CONSENT_KEY, 'denied');
    hideBanner();
  });

  // Permet de rouvrir le bandeau depuis la politique de confidentialité
  window.cloOpenCookieSettings = () => showBanner();
</script>

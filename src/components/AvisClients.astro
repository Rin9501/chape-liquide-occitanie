---
// Bloc avis clients — statique, en dur (pas de widget tiers / appel API Google Places
// pour ne pas réintroduire de script externe qui dégraderait la perf).
// Composant pensé pour être dupliqué tel quel sur les futurs sites clients :
// seule la source de données (import) change.
import { avisGoogle, lienAvisGoogle, type AvisGoogle } from '../data/avis-google';

interface Props {
  eyebrowNum?: string;
}
const { eyebrowNum = '06' } = Astro.props;

function noteLabel(avis: AvisGoogle) {
  return `Note : ${avis.note} sur 5`;
}
---

<section id="avis" class="section-pad bg-bg py-[120px] px-16 pb-[100px]">
  <div class="split-2col grid grid-cols-[0.85fr_2fr] gap-20 mb-16 items-end">
    <div>
      <div class="eyebrow"><span class="num">{eyebrowNum}</span>Avis clients</div>
      <h2 class="h-section text-[56px] mt-6">Ce qu'en disent nos clients.</h2>
    </div>
    <div class="pb-3">
      <p class="lead text-[18px] max-w-[540px]">
        Avis récents laissés sur notre fiche Google — repris ici tels quels, sans filtrage ni mise en scène.
      </p>
    </div>
  </div>

  <div class="avis-grid grid grid-cols-1 md:grid-cols-2 gap-6 mb-12">
    {avisGoogle.map((avis, i) => (
      <div class={`bg-bg-warm flex flex-col justify-between min-h-[220px] p-[32px_28px_28px] border border-line${i > 0 ? ' md:border-l-0' : ''}`}>
        <div>
          <div class="flex justify-between items-baseline mb-5">
            <div class="flex gap-[3px]" role="img" aria-label={noteLabel(avis)}>
              {Array.from({ length: 5 }).map((_, star) => (
                <svg width="16" height="16" viewBox="0 0 24 24" fill={star < avis.note ? '#F0A83C' : 'none'} stroke={star < avis.note ? 'none' : '#DDD2C2'} stroke-width="1.5">
                  <path d="M12 2.5l2.97 6.02 6.64.97-4.8 4.68 1.13 6.61L12 17.77l-5.94 3.01 1.13-6.61-4.8-4.68 6.64-.97L12 2.5z" />
                </svg>
              ))}
            </div>
            <span class="spec text-[9px]">Avis Google</span>
          </div>
          <p class="text-[16px] leading-[1.55] text-ink-soft mb-6">"{avis.texte}"</p>
        </div>
        <div class="font-display font-semibold text-[15px]">{avis.nom}</div>
      </div>
    ))}
  </div>

  <a href={lienAvisGoogle} target="_blank" rel="noopener" class="inline-flex items-center gap-[10px] font-display font-semibold text-[15px] border-b border-ink pb-1">
    <svg width="15" height="15" viewBox="0 0 48 48" aria-hidden="true">
      <path fill="#4285F4" d="M45.12 24.5c0-1.56-.14-3.06-.4-4.5H24v8.51h11.84c-.51 2.75-2.06 5.08-4.39 6.64v5.52h7.11c4.16-3.83 6.56-9.47 6.56-16.17z"/>
      <path fill="#34A853" d="M24 46c5.94 0 10.92-1.97 14.56-5.33l-7.11-5.52c-1.97 1.32-4.49 2.1-7.45 2.1-5.73 0-10.58-3.87-12.31-9.07H4.34v5.7C7.96 41.07 15.4 46 24 46z"/>
      <path fill="#FBBC05" d="M11.69 28.18C11.25 26.86 11 25.45 11 24s.25-2.86.69-4.18v-5.7H4.34C2.85 17.09 2 20.45 2 24s.85 6.91 2.34 9.88l7.35-5.7z"/>
      <path fill="#EA4335" d="M24 10.75c3.23 0 6.13 1.11 8.41 3.29l6.31-6.31C34.91 4.18 29.93 2 24 2 15.4 2 7.96 6.93 4.34 14.12l7.35 5.7c1.73-5.2 6.58-9.07 12.31-9.07z"/>
    </svg>
    Voir tous nos avis sur Google <span class="mono">→</span>
  </a>
</section>
